# ============================================================
# OKEKARAOKE — Git Ignore Policy
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build

# Environment Files (DO NOT commit secret keys!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo

# Testing & Coverage
/coverage

# Vercel Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
