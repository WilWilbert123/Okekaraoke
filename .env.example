# OKEKARAOKE Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (Public - safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (PRIVATE - server-only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# YouTube Data API v3 (server-only for admin search)
YOUTUBE_API_KEY=your-youtube-api-key-here

# App URL (used for QR code generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
